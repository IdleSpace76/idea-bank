{
  "name": "idea-bank",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "local": "node scripts/run-local.mjs dev",
    "local:start": "node scripts/run-local.mjs start",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:auth": "node tests/auth-check.mjs",
    "test:sync-events": "node tests/sync-events-check.mjs && node tests/sync-events-client-check.mjs",
    "test:storage": "node tests/storage-check.mjs",
    "test:disk-storage": "node tests/disk-storage-check.mjs",
    "test:disk-api": "node tests/disk-api-check.mjs",
    "test:local-launch": "node tests/local-launch-check.mjs",
    "test:local-migration": "node tests/local-migration-check.mjs",
    "test:catalog": "node tests/catalog-check.mjs",
    "test:reader": "node tests/shared-reader-check.mjs && node tests/lazy-reader-check.mjs",
    "test:requests": "node tests/request-budget-check.mjs",
    "test:scoped-sync": "node tests/optimistic-sync-check.mjs && node tests/scoped-save-check.mjs && node tests/scoped-sync-check.mjs",
    "test:sync": "node tests/cloud-sync-check.mjs",
    "test:auto-sync": "node tests/auto-sync-check.mjs",
    "storage:cors": "node scripts/configure-b2-cors.mjs",
    "source:check": "node scripts/package-source.mjs --check",
    "source:zip": "node scripts/package-source.mjs"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@tiptap/extension-text-style": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "ably": "2.30.0",
    "better-sqlite3": "12.11.1",
    "fflate": "^0.8.3",
    "hash-wasm": "^4.12.0",
    "lucide-react": "1.66.0",
    "next": "16.4.4",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "typescript": "~5.9.3"
  }
}
