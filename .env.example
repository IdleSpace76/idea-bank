# Шаблон: значения задаются в .env.local или переменных окружения хостинга.
# local (по умолчанию): SQLite и файлы на диске, без входа и облака.
# github: вход владельца; для облачной библиотеки нужны все настройки B2 ниже.
# local, local:start и runIdeaBank.cmd принудительно выбирают local для процесса.
IDEA_BANK_AUTH_MODE=local
# Дисковое хранилище локального режима.
# По умолчанию: ./data внутри папки приложения. Можно задать относительный или абсолютный путь.
IDEA_BANK_DATA_DIR=
# Далее настройки github-режима. Для дискового запуска они не нужны.
# Адрес сайта без пути; локально http://127.0.0.1:3000
AUTH_URL=
# Случайный секрет от 32 символов (см. docs/github-login.md).
AUTH_SECRET=
# Client ID и Client secret собственной GitHub App (не App ID).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Постоянный числовой GitHub ID владельца, не логин.
IDEA_BANK_OWNER_ID=
# Закрытое хранилище облачной библиотеки. Перенос с диска выполняется через ZIP.
B2_S3_ENDPOINT=
B2_REGION=
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=
# Необязательный ключ Ably для уведомлений. Только сервер, без NEXT_PUBLIC_.
ABLY_API_KEY=
# Только для необязательного облачного MCP: true. Для локального STDIO и обычной работы сайта не нужен.
IDEA_BANK_MCP_ENABLED=
