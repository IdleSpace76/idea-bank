# Шаблон: значения задаются в .env.local или переменных окружения хостинга.
# Template: set values in .env.local or the hosting environment.
# local (по умолчанию): SQLite и файлы на диске, без входа и облака.
# local (default): SQLite and files on disk, without sign-in or cloud services.
# github: вход владельца; для облачной библиотеки нужны все настройки B2 ниже.
# github: owner sign-in; a cloud library requires every B2 setting below.
# local, local:start и runIdeaBank.cmd принудительно выбирают local для процесса.
# local, local:start, and runIdeaBank.cmd force local mode for the process.
IDEA_BANK_AUTH_MODE=local
# Дисковое хранилище локального режима.
# Local disk storage.
# По умолчанию: ./data внутри папки приложения. Можно задать относительный или абсолютный путь.
# Default: ./data inside the application folder. Relative and absolute paths are accepted.
IDEA_BANK_DATA_DIR=
# Далее настройки github-режима. Для дискового запуска они не нужны.
# The remaining settings are for github mode; disk launches do not require them.
# Адрес сайта без пути; локально http://127.0.0.1:3000
# Website origin without a path; locally http://127.0.0.1:3000
AUTH_URL=
# Случайный секрет от 32 символов (см. docs/github-login.md).
# Random secret of at least 32 characters (see docs/en/github-login.md).
AUTH_SECRET=
# Client ID и Client secret собственной GitHub App (не App ID).
# Client ID and Client secret from your GitHub App (not App ID).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Постоянный числовой GitHub ID владельца, не логин.
# The owner's stable numeric GitHub ID, not username.
IDEA_BANK_OWNER_ID=
# Закрытое хранилище облачной библиотеки. Перенос с диска выполняется через ZIP.
# Private cloud library storage. Transfers from disk use ZIP.
B2_S3_ENDPOINT=
B2_REGION=
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=
# Необязательный ключ Ably для уведомлений. Только сервер, без NEXT_PUBLIC_.
# Optional Ably notification key. Server-side only, without NEXT_PUBLIC_.
ABLY_API_KEY=
# Только для необязательного облачного MCP: true. Для локального STDIO и обычной работы сайта не нужен.
# Set true only for optional cloud MCP. Local STDIO and regular website use do not need it.
IDEA_BANK_MCP_ENABLED=
