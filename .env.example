# local: без аккаунтов. github: доступ только владельцу.
IDEA_BANK_AUTH_MODE=local
# Заполнять в .env.local или настройках хостинга, никогда в этом файле.
# Адрес сайта без пути; локально http://127.0.0.1:3000
AUTH_URL=
# Случайный секрет от 32 символов (см. docs/github-login.md).
AUTH_SECRET=
# Client ID и Client secret собственной GitHub App (не App ID).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Постоянный числовой GitHub ID владельца, не логин.
IDEA_BANK_OWNER_ID=
# Optional private B2 storage for github mode. Existing local ideas require an owner source choice.
B2_S3_ENDPOINT=
B2_REGION=
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=
# Optional Ably key for sync notifications. Server only; never use NEXT_PUBLIC_.
ABLY_API_KEY=
